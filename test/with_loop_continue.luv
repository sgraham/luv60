# OUT: enter 0
# OUT: body 0
# OUT: exit 0
# OUT: enter 1
# OUT: exit 1
# OUT: enter 2
# OUT: body 2
# OUT: exit 2
# OUT: enter 3
# OUT: exit 3
# OUT: enter 4
# OUT: body 4
# OUT: exit 4
# OUT: enter 5
# OUT: exit 5
# OUT: enter 6
# OUT: body 6
# OUT: exit 6
# OUT: enter 7
# OUT: exit 7
# OUT: enter 8
# OUT: body 8
# OUT: exit 8
# OUT: enter 9
# OUT: exit 9

struct Mgr:
    int a

on Mgr def __enter__(self):
    print fmt("enter {}", self.a)

on Mgr def __exit__(self):
    print fmt("exit {}", self.a)

def Mgr make_it(int val):
    return Mgr(a=val)

def int main():
    for i in range(10):
        with make_it(i):
            if i % 2 == 1:
                continue
            print fmt("body {}", i)
    return 0
