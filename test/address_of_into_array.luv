# OUT: 111
# OUT: 222
# OUT: 333
# OUT: 444
# OUT: 34
def int main():
    [10]int nums
    nums[0] = 111
    nums[1] = 222
    nums[3] = 444

    *int p = &nums[2]
    p[0] = 333

    print nums[0]
    print nums[1]
    print nums[2]
    print nums[3]

    int z = 34
    *int q = &z

    print q[0]

    return 0
