# OUT: true
# OUT: true
# OUT: false
# OUT: false
# OUT: false
# OUT: true
# OUT: s 2,5
# OUT: false
# OUT: true
# OUT: true
# OUT: false
# OUT: t 5,12,2
# OUT: true
# OUT: false
# OUT: true
# OUT: false
# OUT: true
# OUT: u -4,-10,-3
# OUT: false
# OUT: false
# OUT: true
